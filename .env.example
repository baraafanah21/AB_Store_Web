# AB Store environment template.
# Copy to `.env` and fill with real values. Never commit the populated file.

# Database
DB_HOST=localhost
DB_NAME=ab_store
DB_USER=
DB_PASSWORD=
DB_PORT=3306

# Mail (SMTP relay)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=AB Store
